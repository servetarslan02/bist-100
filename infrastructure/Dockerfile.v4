FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN groupadd --gid 10001 alpha \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin alpha \
    && mkdir -p /data \
    && chown 10001:10001 /data

COPY --chown=10001:10001 alpha_v4 /app/alpha_v4

USER 10001:10001

EXPOSE 8765
VOLUME ["/data"]

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import json,urllib.request; p=json.load(urllib.request.urlopen('http://127.0.0.1:8765/health/ready', timeout=2)); assert p['ready'] is True and p['real_money_execution'] is False"

CMD ["python", "-m", "alpha_v4", "serve", "--mode", "research", "--db", "/data/alpha-v4.sqlite3", "--host", "0.0.0.0", "--port", "8765"]
