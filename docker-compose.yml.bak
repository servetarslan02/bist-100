name: bist-100-main
x-common:
  restart: unless-stopped
  env_file: &id001
  - .env
  networks: &id002
  - alpha-net
  logging: &id003
    driver: json-file
    options:
      max-size: 1m
      max-file: '1'
services:
  traefik:
    image: traefik:v3.7
    restart: unless-stopped
    container_name: alpha-traefik
    logging: *id003
    ports:
    - 80:80
    - 443:443
    - 8080:8080
    volumes:
    - ./infrastructure/traefik/traefik.yml:/etc/traefik/traefik.yml:ro
    - ./infrastructure/traefik/dynamic:/etc/traefik/dynamic:ro
    - /var/run/docker.sock:/var/run/docker.sock:ro
    labels:
    - traefik.enable=false
    healthcheck:
      test:
      - CMD-SHELL
      - traefik version || exit 0
      interval: 15s
      timeout: 10s
      retries: 3
      start_period: 10s
    depends_on:
    - api
  postgres:
    restart: unless-stopped
    stop_grace_period: 30s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: timescale/timescaledb:latest-pg17
    container_name: alpha-postgres
    ports:
    - 5432:5432
    volumes:
    - postgres_data:/var/lib/postgresql/data
    - ./database/init:/docker-entrypoint-initdb.d:ro
    command: "postgres\n  -c shared_preload_libraries=timescaledb,pg_stat_statements,auto_explain\n  -c fsync=on\n  -c synchronous_commit=on\n  -c full_page_writes=on\n  -c max_connections=50\n  -c shared_buffers=128MB\n  -c work_mem=4MB\n  -c maintenance_work_mem=64MB\n  -c effective_cache_size=256MB\n  -c wal_level=replica\n  -c max_wal_size=512MB\n  -c min_wal_size=64MB\n  -c max_wal_senders=3\n  -c max_replication_slots=3\n  -c hot_standby=on\n  -c checkpoint_completion_target=0.9\n  -c wal_buffers=8MB\n  -c random_page_cost=1.1\n  -c effective_io_concurrency=100\n  -c max_worker_processes=2\n  -c max_parallel_workers_per_gather=1\n  -c max_parallel_workers=2\n  -c max_parallel_maintenance_workers=1\n  -c autovacuum_max_workers=2\n  -c autovacuum_naptime=60\n  -c log_min_duration_statement=1000\n  -c pg_stat_statements.track=top\n  -c auto_explain.log_min_duration=1000\n"
    environment:
      POSTGRES_DB: alpha_bist
      POSTGRES_USER: alpha
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    healthcheck:
      test:
      - CMD-SHELL
      - pg_isready -U alpha -d alpha_bist
      interval: 5s
      timeout: 5s
      retries: 15
      start_period: 15s
  postgres-replica:
    restart: unless-stopped
    stop_grace_period: 30s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: timescale/timescaledb:latest-pg17
    container_name: alpha-postgres-replica
    ports:
    - 5433:5432
    volumes:
    - postgres_replica_data:/var/lib/postgresql/data
    - ./database/replica/setup.sh:/setup.sh:ro
    entrypoint:
    - /bin/bash
    - /setup.sh
    environment:
      POSTGRES_DB: alpha_bist
      POSTGRES_USER: alpha
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      REPLICATION_PASSWORD: ${REPLICATION_PASSWORD}
      PRIMARY_HOST: alpha-postgres
      PRIMARY_PORT: '5432'
      REPL_USER: replicator
    healthcheck:
      test:
      - CMD-SHELL
      - pg_isready -U alpha -d alpha_bist
      interval: 5s
      timeout: 5s
      retries: 15
      start_period: 60s
    depends_on:
      postgres:
        condition: service_healthy
  clickhouse:
    restart: unless-stopped
    stop_grace_period: 30s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: clickhouse/clickhouse-server:26.3-alpine
    container_name: alpha-clickhouse
    ports:
      - 8123:8123
      - 9002:9000
    volumes:
    - clickhouse_data:/var/lib/clickhouse
    - ./database/clickhouse/config/cluster.xml:/etc/clickhouse-server/config.d/cluster.xml:ro
    - ./database/clickhouse/config/system_logs.xml:/etc/clickhouse-server/config.d/system_logs.xml:ro
    - ./database/clickhouse/init:/docker-entrypoint-initdb.d:ro
    environment:
      CLICKHOUSE_DB: alpha_bist
      CLICKHOUSE_USER: ${CLICKHOUSE_USER}
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD}
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    healthcheck:
      test:
      - CMD-SHELL
      - clickhouse-client --user "$CLICKHOUSE_USER" --password "$CLICKHOUSE_PASSWORD" --query 'SELECT 1'
      interval: 5s
      timeout: 5s
      retries: 15
      start_period: 15s
    depends_on:
      zookeeper:
        condition: service_healthy
  zookeeper:
    restart: unless-stopped
    stop_grace_period: 10s
    env_file: *id001
    environment:
      ZOO_4LW_COMMANDS_WHITELIST: ruok
    networks: *id002
    logging: *id003
    image: zookeeper:3.9.5
    container_name: alpha-zookeeper
    ports:
    - 2181:2181
    volumes:
    - zookeeper_data:/data
    healthcheck:
      test:
      - CMD-SHELL
      - echo ruok | nc -w 2 127.0.0.1 2181 | grep imok
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
  clickhouse-2:
    restart: unless-stopped
    stop_grace_period: 30s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: clickhouse/clickhouse-server:26.3-alpine
    container_name: alpha-clickhouse-2
    ports:
    - 8124:8123
    - 9001:9000
    volumes:
    - clickhouse_2_data:/var/lib/clickhouse
    - ./database/clickhouse/config/cluster-2.xml:/etc/clickhouse-server/config.d/cluster.xml:ro
    - ./database/clickhouse/config/system_logs.xml:/etc/clickhouse-server/config.d/system_logs.xml:ro
    - ./database/clickhouse/init:/docker-entrypoint-initdb.d:ro
    environment:
      CLICKHOUSE_DB: alpha_bist
      CLICKHOUSE_USER: ${CLICKHOUSE_USER}
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD}
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    healthcheck:
      test:
      - CMD-SHELL
      - clickhouse-client --user "$CLICKHOUSE_USER" --password "$CLICKHOUSE_PASSWORD" --query 'SELECT 1'
      interval: 5s
      timeout: 5s
      retries: 15
      start_period: 15s
    depends_on:
      zookeeper:
        condition: service_healthy
  redis:
    restart: unless-stopped
    stop_grace_period: 10s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: redis:8.8-alpine
    container_name: alpha-redis
    ports:
    - 6379:6379
    volumes:
    - redis_data:/data
    command: "redis-server\n  --appendonly no\n  --save 900 1\n  --save 300 10\n  --dir /data\n  --maxmemory 192mb\n  --maxmemory-policy\
      \ allkeys-lru\n  --requirepass ${REDIS_PASSWORD}\n  --masterauth ${REDIS_PASSWORD}\n  --hz 10\n  --dynamic-hz yes\n\
      \  --lazyfree-lazy-eviction yes\n  --lazyfree-lazy-expire yes\n  --lazyfree-lazy-server-del yes\n  --replica-lazy-flush yes\n\
      \  --activedefrag yes\n  --active-defrag-threshold-lower 10\n  --active-defrag-threshold-upper 100\n\
      \  --active-defrag-cycle-min 1\n  --active-defrag-cycle-max 25\n  --tcp-keepalive 300\n  --timeout 0\n"
    healthcheck:
      test:
      - CMD
      - redis-cli
      - -a
      - ${REDIS_PASSWORD}
      - ping
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 5s
  redis-sentinel-1:
    restart: unless-stopped
    stop_grace_period: 10s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: redis:8.8-alpine
    container_name: alpha-sentinel-1
    entrypoint:
    - /bin/sh
    - /etc/sentinel/entrypoint.sh
    volumes:
    - ./infrastructure/sentinel/sentinel-1.conf.template:/etc/sentinel/sentinel.conf.template:ro
    - ./infrastructure/sentinel/entrypoint.sh:/etc/sentinel/entrypoint.sh:ro
    - sentinel_1_data:/data
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test:
      - CMD
      - redis-cli
      - -p
      - '26379'
      - ping
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
  redis-sentinel-2:
    restart: unless-stopped
    stop_grace_period: 10s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: redis:8.8-alpine
    container_name: alpha-sentinel-2
    entrypoint:
    - /bin/sh
    - /etc/sentinel/entrypoint.sh
    volumes:
    - ./infrastructure/sentinel/sentinel-2.conf.template:/etc/sentinel/sentinel.conf.template:ro
    - ./infrastructure/sentinel/entrypoint.sh:/etc/sentinel/entrypoint.sh:ro
    - sentinel_2_data:/data
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test:
      - CMD
      - redis-cli
      - -p
      - '26379'
      - ping
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
  redis-sentinel-3:
    restart: unless-stopped
    stop_grace_period: 10s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: redis:8.8-alpine
    container_name: alpha-sentinel-3
    entrypoint:
    - /bin/sh
    - /etc/sentinel/entrypoint.sh
    volumes:
    - ./infrastructure/sentinel/sentinel-3.conf.template:/etc/sentinel/sentinel.conf.template:ro
    - ./infrastructure/sentinel/entrypoint.sh:/etc/sentinel/entrypoint.sh:ro
    - sentinel_3_data:/data
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test:
      - CMD
      - redis-cli
      - -p
      - '26379'
      - ping
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
  nats:
    restart: unless-stopped
    stop_grace_period: 10s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: nats:2.14-alpine
    container_name: alpha-nats
    ports:
    - 4222:4222
    - 8222:8222
    command: ["nats-server", "-js", "-sd", "/data", "-m", "8222"]
    volumes:
    - nats_data:/data
    storage_opt:
      size: 256M
    healthcheck:
      test:
      - CMD
      - wget
      - --no-verbose
      - --tries=1
      - --spider
      - http://127.0.0.1:8222/healthz
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 5s
  api:
    restart: unless-stopped
    stop_grace_period: 20s
    env_file: *id001
    networks: *id002
    logging: *id003
    build:
      context: .
      dockerfile: infrastructure/Dockerfile.api
    image: alpha-bist-base:latest
    container_name: alpha-api
    ports:
    - 8000:8000
    - 50051:50051
    volumes:
    - ./services:/app/services:ro
    - ./ml:/app/ml:ro
    - ./ai:/app/ai:ro
    - ./backtest:/app/backtest:ro
    - ./config:/app/config:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=32M,mode=1777
    deploy:
      resources:
        reservations:
          devices:
          - driver: nvidia
            count: all
            capabilities:
            - gpu
    environment:
    - TORCH_DEVICE=cuda
    - NVIDIA_VISIBLE_DEVICES=all
    - NVIDIA_DRIVER_CAPABILITIES=compute,utility
    - NATS_URL=nats://nats:4222
    - GRPC_PORT=50051
    - GRPC_HOSTS=alpha-api
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_SERVER_CERT=/app/certs/server.crt
    - MTLS_SERVER_KEY=/app/certs/server.key
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    labels:
    - traefik.enable=true
    - traefik.http.routers.api.rule=PathPrefix(`/api`) || PathPrefix(`/health`) || PathPrefix(`/docs`) || PathPrefix(`/openapi.json`)
    - traefik.http.routers.api.entrypoints=web
    - traefik.http.services.api.loadbalancer.server.port=8000
    - traefik.http.routers.api.middlewares=rate-limit@file,compress@file
    healthcheck:
      test:
      - CMD
      - curl
      - -f
      - http://127.0.0.1:8000/health
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 60s
    depends_on:
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      redis:
        condition: service_healthy
      nats:
        condition: service_healthy
  ingestion:
    restart: unless-stopped
    stop_grace_period: 15s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: alpha-bist-base:latest
    container_name: alpha-ingestion
    command: python -m services.ingestion.main
    volumes:
    - ./services:/app/services:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=16M,mode=1777
    environment:
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    - NATS_URL=nats://nats:4222
    healthcheck:
      test:
      - CMD-SHELL
      - kill -0 1 || exit 1
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      api:
        condition: service_healthy
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      redis:
        condition: service_healthy
  feature-engine:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    image: alpha-bist-base:latest
    container_name: alpha-feature-engine
    command: python -m services.features.main
    volumes:
    - ./services:/app/services:ro
    - ./ml:/app/ml:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=16M,mode=1777
    deploy:
      resources:
        reservations:
          devices:
          - driver: nvidia
            count: all
            capabilities:
            - gpu
    environment:
    - TORCH_DEVICE=cuda
    - NVIDIA_VISIBLE_DEVICES=all
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    healthcheck:
      test:
      - CMD-SHELL
      - kill -0 1 || exit 1
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      api:
        condition: service_healthy
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      redis:
        condition: service_healthy
  market-state:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    image: alpha-bist-base:latest
    container_name: alpha-market-state
    command: python -m services.market_state.main
    volumes:
    - ./services:/app/services:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=8M,mode=1777
    environment:
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    healthcheck:
      test:
      - CMD-SHELL
      - kill -0 1 || exit 1
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      api:
        condition: service_healthy
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      redis:
        condition: service_healthy
  intelligence:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    image: alpha-bist-base:latest
    container_name: alpha-intelligence
    command: python -m services.intelligence.main
    volumes:
    - ./services:/app/services:ro
    - ./ml:/app/ml:ro
    - ./ai:/app/ai:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=32M,mode=1777
    deploy:
      resources:
        reservations:
          devices:
          - driver: nvidia
            count: all
            capabilities:
            - gpu
    environment:
    - TORCH_DEVICE=cuda
    - NVIDIA_VISIBLE_DEVICES=all
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    healthcheck:
      test:
      - CMD-SHELL
      - kill -0 1 || exit 1
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      api:
        condition: service_healthy
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      redis:
        condition: service_healthy
  simulation:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    image: alpha-bist-base:latest
    container_name: alpha-simulation
    command: python -m services.simulation.main
    volumes:
    - ./services:/app/services:ro
    - ./ml:/app/ml:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=16M,mode=1777
    deploy:
      resources:
        reservations:
          devices:
          - driver: nvidia
            count: all
            capabilities:
            - gpu
    environment:
    - TORCH_DEVICE=cuda
    - NVIDIA_VISIBLE_DEVICES=all
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    healthcheck:
      test:
      - CMD-SHELL
      - kill -0 1 || exit 1
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      api:
        condition: service_healthy
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      redis:
        condition: service_healthy
  risk:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    image: alpha-bist-base:latest
    container_name: alpha-risk
    command: python -m services.risk.main
    volumes:
    - ./services:/app/services:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=8M,mode=1777
    environment:
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    healthcheck:
      test:
      - CMD-SHELL
      - kill -0 1 || exit 1
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      api:
        condition: service_healthy
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
  portfolio:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    image: alpha-bist-base:latest
    container_name: alpha-portfolio
    command: python -m services.portfolio.main
    volumes:
    - ./services:/app/services:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=8M,mode=1777
    environment:
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    healthcheck:
      test:
      - CMD-SHELL
      - kill -0 1 || exit 1
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      api:
        condition: service_healthy
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
  learning:
    restart: unless-stopped
    stop_grace_period: 15s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: alpha-bist-base:latest
    container_name: alpha-learning
    command: python -m services.learning.main
    volumes:
    - ./services:/app/services:ro
    - ./ml:/app/ml:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=16M,mode=1777
    deploy:
      resources:
        reservations:
          devices:
          - driver: nvidia
            count: all
            capabilities:
            - gpu
    environment:
    - TORCH_DEVICE=cuda
    - NVIDIA_VISIBLE_DEVICES=all
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    healthcheck:
      test:
      - CMD-SHELL
      - kill -0 1 || exit 1
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    depends_on:
      api:
        condition: service_healthy
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      redis:
        condition: service_healthy
  celery-worker:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    image: alpha-bist-base:latest
    container_name: alpha-celery-worker
    command: celery -A services.tasks.queue worker --loglevel=info --concurrency=2 --without-gossip --without-mingle --without-heartbeat
    volumes:
    - ./services:/app/services:ro
    - ./ml:/app/ml:ro
    - ./data:/app/data
    - ./.env:/app/.env:ro
    - ./infrastructure/mtls/certs:/app/certs:ro
    tmpfs:
    - /tmp:size=16M,mode=1777
    environment:
    - REDIS_HOST=redis
    - REDIS_PASSWORD=${REDIS_PASSWORD}
    - REDIS_SENTINEL_HOSTS=alpha-sentinel-1:26379,alpha-sentinel-2:26379,alpha-sentinel-3:26379
    - REDIS_SENTINEL_MASTER=alpha-master
    - MTLS_CA_CERT=/app/certs/ca.crt
    - MTLS_CLIENT_CERT=/app/certs/client.crt
    - MTLS_CLIENT_KEY=/app/certs/client.key
    healthcheck:
      test:
      - CMD-SHELL
      - celery -A services.tasks.queue inspect ping --timeout 5 || exit 1
      interval: 30s
      timeout: 20s
      retries: 3
      start_period: 60s
    depends_on:
      redis:
        condition: service_healthy
  dashboard:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    build:
      context: ./apps/web
      dockerfile: Dockerfile
    container_name: alpha-dashboard
    ports:
    - 3000:3000
    environment:
    - API_URL=http://alpha-api:8000
    labels:
    - traefik.enable=true
    - traefik.http.routers.dashboard.rule=PathPrefix(`/`)
    - traefik.http.routers.dashboard.entrypoints=web
    - traefik.http.services.dashboard.loadbalancer.server.port=3000
    tmpfs:
    - /tmp:size=16M,mode=1777
    depends_on:
    - api
    healthcheck:
      test:
      - CMD
      - wget
      - --no-verbose
      - --tries=1
      - --spider
      - http://127.0.0.1:3000
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
  postgres-exporter:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    image: prometheuscommunity/postgres-exporter:v0.17.1
    container_name: alpha-postgres-exporter
    ports:
    - 9187:9187
    environment:
      DATA_SOURCE_NAME: postgresql://alpha:${POSTGRES_PASSWORD}@postgres:5432/alpha_bist?sslmode=disable
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test:
      - CMD
      - wget
      - --no-verbose
      - --tries=1
      - --spider
      - http://127.0.0.1:9187/metrics
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
  redis-exporter:
    restart: unless-stopped
    env_file: *id001
    networks: *id002
    logging: *id003
    image: oliver006/redis_exporter:v1.73.0-alpine
    container_name: alpha-redis-exporter
    ports:
    - 9121:9121
    environment:
      REDIS_ADDR: redis://redis:6379
      REDIS_PASSWORD: ${REDIS_PASSWORD}
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test:
      - CMD
      - wget
      - --no-verbose
      - --tries=1
      - --spider
      - http://127.0.0.1:9121/metrics
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
  prometheus:
    restart: unless-stopped
    stop_grace_period: 10s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: prom/prometheus:v3.14.0
    container_name: alpha-prometheus
    ports:
    - 9090:9090
    volumes:
    - ./infrastructure/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    - prometheus_data:/prometheus
    healthcheck:
      test:
      - CMD
      - wget
      - --no-verbose
      - --tries=1
      - --spider
      - http://127.0.0.1:9090/-/healthy
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 180s
  grafana:
    restart: unless-stopped
    stop_grace_period: 10s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: grafana/grafana:13.0.7
    container_name: alpha-grafana
    ports:
    - 3001:3000
    volumes:
    - ./infrastructure/grafana/dashboards:/etc/grafana/provisioning/dashboards:ro
    - ./infrastructure/grafana/datasources:/etc/grafana/provisioning/datasources:ro
    - grafana_data:/var/lib/grafana
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_PASSWORD}
    healthcheck:
      test:
      - CMD
      - wget
      - --no-verbose
      - --tries=1
      - --spider
      - http://127.0.0.1:3000/api/health
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 240s
  mlflow:
    restart: unless-stopped
    stop_grace_period: 10s
    env_file: *id001
    networks: *id002
    logging: *id003
    image: ghcr.io/mlflow/mlflow:v3.15.2
    container_name: alpha-mlflow
    ports:
    - 5000:5000
    volumes:
    - mlflow_data:/mlflow
    command: >
      sh -c "pip install -q psycopg2-binary && mlflow server --host 0.0.0.0 --port 5000 --backend-store-uri postgresql://${POSTGRES_USER:-alpha}:${POSTGRES_PASSWORD}@postgres:5432/alpha_mlflow --default-artifact-root /mlflow/artifacts --allowed-hosts '*' --workers 1"
    environment:
      MLFLOW_BACKEND_STORE_URI: postgresql://${POSTGRES_USER:-alpha}:${POSTGRES_PASSWORD}@postgres:5432/alpha_mlflow
      MLFLOW_SERVER_ALLOWED_HOSTS: "*"
      MLFLOW_ALLOWED_HOSTS: "*"
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test:
      - CMD
      - python3
      - -c
      - import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health')
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
  pgbouncer:
    restart: unless-stopped
    stop_grace_period: 10s
    networks: *id002
    logging: *id003
    image: edoburu/pgbouncer:latest
    container_name: alpha-pgbouncer
    ports:
    - 6432:5432
    environment:
      DATABASE_URL: "postgres://alpha:${POSTGRES_PASSWORD}@alpha-postgres:5432/alpha_bist"
      POOL_MODE: transaction
      MAX_CLIENT_CONN: 200
      DEFAULT_POOL_SIZE: 25
      MIN_POOL_SIZE: 5
      RESERVE_POOL_SIZE: 5
      RESERVE_POOL_TIMEOUT: 3
      SERVER_IDLE_TIMEOUT: 300
      SERVER_LIFETIME: 3600
      SERVER_CONNECT_TIMEOUT: 15
      QUERY_TIMEOUT: 120
      QUERY_WAIT_TIMEOUT: 120
      LOG_CONNECTIONS: 1
      LOG_DISCONNECTIONS: 1
      LOG_POOLER_ERRORS: 1
      STATS_PERIOD: 60
    healthcheck:
      test:
      - CMD-SHELL
      - pg_isready -h 127.0.0.1 -p 5432 -U alpha
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    depends_on:
      postgres:
        condition: service_healthy
  questdb:
    restart: unless-stopped
    stop_grace_period: 10s
    networks: *id002
    logging: *id003
    image: questdb/questdb:10.0.1
    container_name: alpha-questdb
    ports:
    - 9009:9009
    - 8812:8812
    - 9000:9000
    volumes:
    - questdb_data:/var/lib/questdb
    environment:
      QDB_PG_NET_ENABLED: "true"
      QDB_HTTP_ENABLED: "true"
      QDB_LINE_TCP_ENABLED: "true"
      QDB_LINE_TCP_NET_BIND_TO: "0.0.0.0:9009"
    healthcheck:
      test:
      - CMD-SHELL
      - curl -f http://127.0.0.1:9000/ping || exit 1
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s
  autoheal:
    image: willfarrell/autoheal
    restart: always
    networks: *id002
    logging: *id003
    volumes:
    - /var/run/docker.sock:/var/run/docker.sock
    environment:
    - AUTOHEAL_CONTAINER_LABEL=autoheal
    - AUTOHEAL_INTERVAL=60
    - AUTOHEAL_START_PERIOD=300
volumes:
  postgres_data: null
  postgres_replica_data: null
  clickhouse_data: null
  clickhouse_2_data: null
  zookeeper_data: null
  redis_data: null
  nats_data: null
  prometheus_data: null
  grafana_data: null
  mlflow_data: null
  questdb_data: null
  sentinel_1_data: null
  sentinel_2_data: null
  sentinel_3_data: null
networks:
  alpha-net:
    driver: bridge
