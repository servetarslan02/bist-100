# ========================================================
# STAGE 1: Builder (Wheel Derleme & Derleyici Katmanı)
# ========================================================
FROM python:3.12-slim AS builder

WORKDIR /build

# Derleme araçları (sadece build aşamasında tutulur, runtime'a sızmaz)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev build-essential && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ========================================================
# STAGE 2: Runtime (Minimal Saldırı Yüzeyi & Non-Root)
# ========================================================
FROM python:3.12-slim AS runtime

WORKDIR /app

# Sadece runtime ve healthcheck için gerekli hafif paketler (gcc yok)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libpq5 && \
    rm -rf /var/lib/apt/lists/*

# Builder aşamasından derlenmiş Python paketlerini kopyala
COPY --from=builder /install /usr/local
ENV PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Uygulama kodunu kopyala
COPY . /app

# Non-root sistem kullanıcısı ve yetkilendirme
RUN groupadd -r alpha && useradd -r -g alpha -d /app -s /sbin/nologin alpha && \
    chown -R alpha:alpha /app

USER alpha

# Expose API (HTTP/WebSocket) + gRPC Portları
EXPOSE 8000 50051

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "services.api.app:app", "--host", "0.0.0.0", "--port", "8000"]

