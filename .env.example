# ALPHA BIST - Environment Configuration
# Copy to .env and fill in your values

# === Database ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alpha_bist
POSTGRES_USER=alpha
POSTGRES_PASSWORD=alpha_secure_2026

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=alpha_bist
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# === Event Bus ===
REDPANDA_BROKERS=redpanda:9092

# === LLM ===
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b-q4_0
LLM_CONTEXT_SIZE=8192

# === Data Sources ===
# yfinance is free, no API key needed
# TCMB EVDS - get free key from evds.tcmb.gov.tr
TCMB_EVDS_API_KEY=your_evds_key_here

# NewsAPI - get free key from newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage - get free key from alphavantage.co
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
DASHBOARD_PORT=3000

# === Security ===
SECRET_KEY=change-this-to-random-string
JWT_SECRET=change-this-to-random-string

# === Monitoring ===
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
