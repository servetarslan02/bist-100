# ALPHA BIST — Production Environment Configuration
# Copy to .env and fill in YOUR values
# NEVER commit .env to version control

# === Application ===
APP_ENV=development          # development | staging | production
APP_DEBUG=true               # MUST be false in production
APP_HOST=0.0.0.0
APP_PORT=8000

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alpha_bist
POSTGRES_USER=alpha
POSTGRES_PASSWORD=              # REQUIRED in production (min 16 chars)

# === ClickHouse ===
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=alpha_bist
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === Event Bus ===
REDPANDA_BROKERS=localhost:9092

# === LLM ===
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=gemma4:12b-q4_0
LLM_CONTEXT_SIZE=8192
# Qwen3: Türkçe finansal analizde en iyi (LinkedIn 2026)
# gemma4: Fallback model olarak korunuyor

# === Data Sources ===
# yfinance — free, no key needed
# TCMB EVDS — get free key from evds.tcmb.gov.tr
TCMB_EVDS_API_KEY=
# NewsAPI — get free key from newsapi.org
NEWS_API_KEY=
# Alpha Vantage — get free key from alphavantage.co
ALPHA_VANTAGE_KEY=

# === Broker (required for live trading) ===
BROKER_TYPE=paper              # paper | live
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=

# === KAP ===
KAP_API_KEY=

# === Security (REQUIRED in production, min 16 chars each) ===
SECRET_KEY=                    # REQUIRED in production
JWT_SECRET=                    # REQUIRED in production

# === Monitoring ===
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# === MLflow (legacy, W&B tercih edilir) ===
MLFLOW_TRACKING_URI=http://localhost:5000

# === Weights & Biases (EN İYİ experiment tracking) ===
WANDB_API_KEY=
WANDB_PROJECT=alpha-bist
WANDB_ENTITY=

# === Ray (distributed computing) ===
RAY_ADDRESS=auto
RAY_NUM_CPUS=4
RAY_NUM_GPUS=0

# === Deep Learning ===
TORCH_DEVICE=cpu  # cpu | cuda | mps
TABNET_ENABLED=true
FT_TRANSFORMER_ENABLED=true

# === DB Pool ===
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_COMMAND_TIMEOUT=30

# === Scheduler Intervals (seconds) ===
INTERVAL_FEATURE_CALCULATION=300
INTERVAL_LIVE_INFERENCE=300
INTERVAL_HEALTH_CHECK=60
INTERVAL_MARKET_DATA=120
INTERVAL_RANKING=600
