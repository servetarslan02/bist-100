FROM python:3.12-slim

WORKDIR /app

# System deps (healthcheck + replica + build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl netcat-openbsd gosu && \
    rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Non-root user for security
RUN groupadd -r alpha && useradd -r -g alpha -d /app -s /sbin/nologin alpha && \
    chown -R alpha:alpha /app
USER alpha

# App code
COPY --chown=alpha:alpha . .

# Expose API + gRPC ports
EXPOSE 8000 50051

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "services.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
