<clickhouse>
    <!-- Cluster tanımı: tek node (tek makine kurulumu) -->
    <remote_servers>
        <alpha_cluster>
            <shard>
                <internal_replication>false</internal_replication>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </alpha_cluster>
    </remote_servers>

    <!-- ZooKeeper entegrasyonu -->
    <zookeeper>
        <node>
            <host>zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>

    <!-- Macros: tek node için -->
    <macros>
        <cluster>alpha_cluster</cluster>
        <shard>01</shard>
        <replica>replica1</replica>
    </macros>
</clickhouse>
