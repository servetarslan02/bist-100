{
  "version": "4.2.0",
  "environment": "development",
  "app": {
    "env": "development",
    "debug": true,
    "host": "0.0.0.0",
    "port": 8000
  },
  "models": {
    "primary": "lightgbm",
    "ensemble": ["lightgbm", "xgboost", "catboost"],
    "deep_learning": ["lstm", "transformer"],
    "reinforcement": "ppo",
    "retrain_interval_hours": 24,
    "min_training_samples": 500,
    "walk_forward_folds": 5,
    "champion_challenger_enabled": true
  },
  "scanner": {
    "universe_size": 100,
    "scan_interval_seconds": 300,
    "min_score": 50,
    "max_results": 20,
    "momentum_window": 20,
    "volume_threshold": 1000000
  },
  "learning": {
    "enabled": true,
    "brier_threshold": 0.25,
    "directional_accuracy_threshold": 0.55,
    "retrain_trigger_score": 0.40,
    "max_model_age_days": 30,
    "shadow_mode": false
  },
  "data_sources": {
    "yfinance": {"enabled": true, "interval": "1d", "period": "2y"},
    "kap": {"enabled": true, "refresh_minutes": 5},
    "tcmb": {"enabled": true, "refresh_hours": 1},
    "news": {"enabled": true, "refresh_minutes": 15},
    "social": {"enabled": true, "refresh_minutes": 30},
    "google_trends": {"enabled": true, "refresh_hours": 4}
  },
  "portfolio": {
    "initial_capital": 100000,
    "max_position_pct": 0.10,
    "max_sector_concentration": 0.30,
    "max_drawdown_pct": 15.0,
    "daily_loss_limit_pct": 5.0,
    "commission": {
      "broker_rate": 0.0003,
      "exchange_rate": 0.000056,
      "bsmv_rate": 0.05,
      "min_commission": 1.0
    }
  },
  "risk": {
    "max_position_pct": 10,
    "max_sector_pct": 30,
    "max_drawdown_pct": 15,
    "daily_loss_limit_pct": 5,
    "target_volatility": 0.15,
    "kelly_fraction": 0.5
  },
  "data": {
    "cache_dir": "data/cache",
    "cache_ttl_hours": 24,
    "yfinance_interval": "1d",
    "yfinance_period": "2y"
  },
  "features": {
    "rsi_period": 14,
    "macd_fast": 12,
    "macd_slow": 26,
    "macd_signal": 9,
    "bb_period": 20,
    "bb_std": 2.0,
    "atr_period": 14,
    "adx_period": 14,
    "obv_enabled": true,
    "mfi_period": 14,
    "cmf_period": 20
  },
  "monitoring": {
    "metrics_token_env": "ALPHA_METRICS_TOKEN",
    "admin_token_env": "ALPHA_ADMIN_TOKEN",
    "health_check_interval_s": 60,
    "lock_timeout_s": 300,
    "lock_heartbeat_s": 100
  },
  "bist": {
    "universe_refresh_hours": 24,
    "index_tickers": ["XU100", "XU030", "XU050"],
    "default_sector": "OTHER"
  }
}
