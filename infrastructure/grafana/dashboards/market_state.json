{
  "dashboard": {
    "id": null,
    "title": "ALPHA BIST — Market State Engine v2.0",
    "tags": ["alpha-bist", "market-state", "regime"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Current Regime",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "market_state_regime",
            "legendFormat": "Regime"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"BULL": {"text": "🟢 BULL", "color": "green"}}},
              {"type": "value", "options": {"BEAR": {"text": "🔴 BEAR", "color": "red"}}},
              {"type": "value", "options": {"SIDEWAYS": {"text": "🟡 SIDEWAYS", "color": "yellow"}}},
              {"type": "value", "options": {"CRISIS": {"text": "🔴 CRISIS", "color": "dark-red"}}},
              {"type": "value", "options": {"RISK_ON": {"text": "🟢 RISK-ON", "color": "green"}}},
              {"type": "value", "options": {"RISK_OFF": {"text": "🔴 RISK-OFF", "color": "red"}}}
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Regime Confidence",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "market_state_regime_confidence",
            "legendFormat": "Confidence"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.3, "color": "yellow"},
                {"value": 0.6, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Risk Appetite",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "market_state_risk_appetite",
            "legendFormat": "Risk Appetite"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.3, "color": "yellow"},
                {"value": 0.5, "color": "green"},
                {"value": 0.7, "color": "dark-green"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Stability Score",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "market_state_stability",
            "legendFormat": "Stability"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.5, "color": "yellow"},
                {"value": 0.8, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Market Breadth (% Advancing)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "market_state_breadth_pct",
            "legendFormat": "% Advancing"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 30, "color": "yellow"},
                {"value": 50, "color": "green"},
                {"value": 70, "color": "dark-green"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "McClellan Oscillator",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "market_state_mcclellan",
            "legendFormat": "McClellan"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"value": -100, "color": "red"},
                {"value": -50, "color": "yellow"},
                {"value": 0, "color": "green"},
                {"value": 50, "color": "dark-green"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Component States",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "market_state_momentum_state",
            "legendFormat": "Momentum"
          },
          {
            "expr": "market_state_volatility_state",
            "legendFormat": "Volatility"
          },
          {
            "expr": "market_state_volume_state",
            "legendFormat": "Volume"
          },
          {
            "expr": "market_state_rsi_state",
            "legendFormat": "RSI"
          },
          {
            "expr": "market_state_liquidity_state",
            "legendFormat": "Liquidity"
          },
          {
            "expr": "market_state_sentiment_state",
            "legendFormat": "Sentiment"
          }
        ]
      },
      {
        "id": 8,
        "title": "Ensemble Methods",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "market_state_ensemble_score_confidence",
            "legendFormat": "Score-based"
          },
          {
            "expr": "market_state_ensemble_hmm_confidence",
            "legendFormat": "HMM"
          },
          {
            "expr": "market_state_ensemble_gmm_confidence",
            "legendFormat": "GMM"
          }
        ]
      },
      {
        "id": 9,
        "title": "Regime Timeline",
        "type": "state-timeline",
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "market_state_regime",
            "legendFormat": "Regime"
          }
        ]
      },
      {
        "id": 10,
        "title": "TRIN / Arms Index",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 26},
        "targets": [
          {
            "expr": "market_state_trin",
            "legendFormat": "TRIN"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"value": 0, "color": "dark-green"},
                {"value": 0.5, "color": "green"},
                {"value": 1.0, "color": "yellow"},
                {"value": 1.5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Anomaly Count",
        "type": "stat",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 26},
        "targets": [
          {
            "expr": "market_state_anomaly_count",
            "legendFormat": "Anomalies"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 3, "color": "yellow"},
                {"value": 5, "color": "red"},
                {"value": 10, "color": "dark-red"}
              ]
            }
          }
        }
      }
    ]
  }
}
