<clickhouse>
    <!-- ============================================================= -->
    <!-- ALPHA BIST — ClickHouse Performance Configuration              -->
    <!-- ============================================================= -->

    <!-- Thread ayarları -->
    <max_threads>4</max_threads>
    <max_concurrent_queries>100</max_concurrent_queries>

    <!-- Bellek ayarları -->
    <max_memory_usage>268435456</max_memory_usage>  <!-- 256MB per query -->
    <max_memory_usage_for_all_queries>536870912</max_memory_usage_for_all_queries>  <!-- 512MB total -->
    <max_table_size_to_drop>1073741824</max_table_size_to_drop>  <!-- 1GB -->
    <max_partition_size_to_drop>1073741824</max_partition_size_to_drop>

    <!-- Query optimizasyonu -->
    <distributed_product_mode>global</distributed_product_mode>
    <max_query_size>10485760</max_query_size>  <!-- 10MB -->
    <max_ast_elements>100000</max_ast_elements>
    <max_expanded_ast_elements>1000000</max_expanded_ast_elements>
    <max_bytes_in_join>104857600</max_bytes_in_join>  <!-- 100MB -->
    <max_rows_in_join>1000000</max_rows_in_join>
    <max_bytes_in_distinct>104857600</max_bytes_in_distinct>
    <max_rows_in_distinct>1000000</max_rows_in_distinct>

    <!-- MergeTree optimizasyonları — SSD write reduction -->
    <merge_tree>
        <max_suspicious_broken_parts>50</max_suspicious_broken_parts>
        <parts_to_delay_insert>500</parts_to_delay_insert>
        <parts_to_throw_insert>1000</parts_to_throw_insert>
        <max_part_loading_threads>4</max_part_loading_threads>
        <max_part_removal_threads>4</max_part_removal_threads>
        <number_of_free_entries_in_pool_to_execute_mutation>1</number_of_free_entries_in_pool_to_execute_mutation>
        <max_delay_to_insert>5</max_delay_to_insert>
        <number_of_mutations_to_delay>100</number_of_mutations_to_delay>
        <number_of_mutations_to_throw>500</number_of_mutations_to_throw>
    </merge_tree>

    <!-- Background thread pool — SSD write reduction -->
    <background_pool_size>4</background_pool_size>
    <background_merges_mutations_concurrency_ratio>1</background_merges_mutations_concurrency_ratio>
    <background_schedule_pool_size>4</background_schedule_pool_size>
    <background_fetches_pool_size>2</background_fetches_pool_size>
    <background_common_pool_size>2</background_common_pool_size>
    <background_buffer_flush_schedule_pool_size>2</background_buffer_flush_schedule_pool_size>
    <background_move_pool_size>2</background_move_pool_size>

    <!-- Network optimizasyonları -->
    <max_replicated_fetches_network_bandwidth_for_server>104857600</max_replicated_fetches_network_bandwidth_for_server>  <!-- 100MB/s -->
    <max_replicated_sends_network_bandwidth_for_server>104857600</max_replicated_sends_network_bandwidth_for_server>

    <!-- Log ayarları — SSD write reduction -->
    <send_logs_level>error</send_logs_level>
    <log_queries>0</log_queries>
    <log_queries_min_type>QUERY_FINISH</log_queries_min_type>
    <log_queries_min_query_duration_ms>5000</log_queries_min_query_duration_ms>
    <log_query_threads>0</log_query_threads>

    <!-- Cache ayarları -->
    <mark_cache_size>5368709120</mark_cache_size>  <!-- 5GB -->
    <uncompressed_cache_size>268435456</uncompressed_cache_size>  <!-- 256MB -->

    <!-- Compression -->
    <compression>
        <case>
            <min_part_size>1048576</min_part_size>
            <min_part_size_ratio>0.01</min_part_size_ratio>
            <method>zstd</method>
            <level>3</level>
        </case>
    </compression>
</clickhouse>
